{
  "name": "@wgalleti/primevue-components",
  "version": "0.11.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "yarn@1.22.22",
  "bin": {
    "wpvc": "bin/wpvc.mjs"
  },
  "files": [
    "dist",
    "bin",
    "skill"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./composables": {
      "types": "./dist/composables.d.ts",
      "import": "./dist/composables.js",
      "require": "./dist/composables.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./style.css": "./dist/primevue-components.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "resolutions": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "dev": "yarn --cwd playground dev",
    "build": "vite build",
    "meta": "node scripts/gen-component-meta.mjs --write",
    "meta:check": "node scripts/gen-component-meta.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{vue,js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{vue,js,ts}\" --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepublishOnly": "yarn type-check && yarn test && yarn build",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:publish": "npm publish --registry https://registry.npmjs.org/ && git push --follow-tags origin main",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "axios": "^1.0.0",
    "dayjs": "^1.11.0",
    "primevue": "^4.2.0",
    "vue": "^3.4.0",
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "highlight.js": "^11.12.0",
    "leaflet": "^1.9.4",
    "markdown-it": "^15.0.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "maska": "^3.2.0",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@primevue/themes": "^4.2.0",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "axios": "^1.7.0",
    "commit-and-tag-version": "^13.1.2",
    "dayjs": "^1.11.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-component-meta": "^2.2.0",
    "vue-router": "^4.4.0",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
