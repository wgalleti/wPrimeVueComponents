{
  "name": "@wgalleti/primevue-components",
  "version": "0.6.1",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "yarn@1.22.22",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./composables": {
      "types": "./dist/composables.d.ts",
      "import": "./dist/composables.js",
      "require": "./dist/composables.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./style.css": "./dist/primevue-components.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "resolutions": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "dev": "yarn --cwd playground dev",
    "build": "vite build",
    "meta": "node scripts/gen-component-meta.mjs --write",
    "meta:check": "node scripts/gen-component-meta.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{vue,js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{vue,js,ts}\" --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepublishOnly": "yarn build",
    "release": "yarn type-check && yarn build && npm publish --registry https://registry.npmjs.org/",
    "release:patch": "yarn version --patch && yarn release",
    "release:minor": "yarn version --minor && yarn release",
    "release:major": "yarn version --major && yarn release",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "axios": "^1.0.0",
    "dayjs": "^1.11.0",
    "primevue": "^5.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "maska": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@primevue/themes": "^4.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "prettier": "^3.4.0",
    "primeicons": "^8.0.0",
    "primevue": "^5.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-component-meta": "^3.3.8",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
